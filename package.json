{
  "name": "memex-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check": "pnpm run lint && pnpm run arch && pnpm run markers && pnpm run typecheck && pnpm run unused && pnpm run test && pnpm run docs:check && pnpm run docs:lint",
    "lint": "biome check .",
    "arch": "depcruise memex factory/validation",
    "markers": "node harness/sensors/marker-words.mjs memex",
    "typecheck": "pnpm --recursive --no-bail run typecheck && tsc --project harness/tsconfig.json",
    "unused": "knip",
    "test": "vitest run",
    "docs:check": "node harness/sensors/docs/cli.ts check",
    "docs:lint": "markdownlint-cli2 \"factory/as-built/**/*.md\"",
    "docs:stale": "node harness/sensors/docs/cli.ts stale",
    "docs:generate": "node harness/sensors/docs/cli.ts generate",
    "plan:order": "node harness/tools/plan-order.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.7.0",
    "knip": "6.44.0",
    "markdownlint-cli2": "0.23.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
