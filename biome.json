{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!pnpm-lock.yaml",
      "!playbook",
      "!factory/design",
      "!factory/records"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "complexity": {
        "useArrowFunction": "error",
        "noExcessiveCognitiveComplexity": "error"
      },
      "nursery": {
        "useExplicitType": "error",
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "style": {
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "noNestedTernary": "error",
        "noProcessEnv": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "noParameterProperties": "error",
        "noNonNullAssertion": "error",
        "noDefaultExport": "error",
        "noCommonJs": "error",
        "useNamingConvention": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        },
        "noMagicNumbers": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**", "!harness/**", "!.claude/hooks/**"],
      "plugins": ["./harness/sensors/no-function-declaration.grit"]
    },
    {
      "includes": ["harness/**", ".claude/hooks/**"],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "off",
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {
            "useExplicitType": "off",
            "noFloatingPromises": "off",
            "noMisusedPromises": "off"
          },
          "style": {
            "noParameterAssign": "off",
            "noUselessElse": "off",
            "noNestedTernary": "off",
            "noProcessEnv": "off",
            "noEnum": "off",
            "noNamespace": "off",
            "noParameterProperties": "off",
            "noNonNullAssertion": "off",
            "noDefaultExport": "off",
            "noCommonJs": "off",
            "useNamingConvention": "off",
            "useFilenamingConvention": "off",
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": ["memex/packages/runtime/src/composition-root/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [".dependency-cruiser.cjs"],
      "linter": {
        "rules": {
          "style": {
            "noCommonJs": "off"
          }
        }
      }
    }
  ]
}
