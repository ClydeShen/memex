# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test and coverage output
coverage/

# Secrets: keys are referenced via ${env:NAME} and never committed or snapshotted
.env
.env.*
!.env.example

# Models are downloaded per machine and verified by sha256, never shipped (ADR 0013)
*.gguf
*.safetensors

# Instance data: event logs, snapshots, recordings, reports (docs/project-structure.md section 4).
# Synthetic test fixtures live in each package's fixtures/ and are committed.
.memex/

# Logs
*.log
npm-debug.log*

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code local settings
.claude/settings.local.json
