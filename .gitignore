# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test and coverage output
coverage/

# Secrets: keys are referenced via ${env:NAME} and never committed or snapshotted
.env
.env.*
!.env.example

# Models are downloaded per machine and verified by sha256, never shipped (ADR 0013)
*.gguf
*.safetensors

# Instance-local runtime data: event logs, snapshots, recordings, reports.
# Placeholder paths; finalize when M0.3/M0.5 fix the on-disk layout.
# Recordings meant as test fixtures live under the package's test dir and are committed.
.memex/
runs/

# Logs
*.log
npm-debug.log*

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code local settings
.claude/settings.local.json
