{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.ts\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(/.githooks/**)",
      "Edit(/.claude/**)",
      "Edit(/harness/sensors/**)",
      "Edit(/.github/**)",
      "Edit(/.dependency-cruiser.cjs)",
      "Edit(/biome.json)",
      "Edit(/knip.json)"
    ]
  }
}
