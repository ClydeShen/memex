# Copy to .env and fill in for this machine. .env is never committed:
# machine-specific facts belong to the Instance, not the Framework.
# Checks to run: HANDOFF.md section 4 (L1-L10).

# L1 OS and hardware
ENV_OS=
ENV_WSL2=
ENV_CPU=
ENV_RAM_GB=
ENV_GPU=
ENV_GPU_VRAM_MB=
ENV_GPU_DRIVER=

# L2/L3 toolchain (Node: version in .nvmrc)
ENV_NODE=
ENV_NPM=
ENV_NODE_PATH=
ENV_GIT=
ENV_PNPM=

# L4/L7 Model Backend
LLAMA_SERVER_PATH=
LLAMA_CPP_BUILD=
LLAMA_BASE_URL=http://127.0.0.1:8080/v1

# L5/L6 backend capabilities: pass | fail
ENV_LLAMA_LOGPROBS=
ENV_LLAMA_THINKING_TOGGLE=

# L8 models
MODEL_DIR=

# L9 Docker GPU (optional)
ENV_DOCKER=
ENV_DOCKER_GPU=

# L10
ENV_SKILL_PLAN_DELIVERY=
